# NAIC deployment — NUC6i5 (TPCtoss.nl patroon)
# Windows-pad:  P:/Jules/Apps/NAIC
# Linux-pad:    /mnt/p/Jules/Apps/NAIC  (P:-schijf gemount op Ubuntu)

# Doelserver
NUC_HOST=192.168.178.79
NUC_USER=jules
NUC_NAME=NUC6i5

# App-locatie (zelfde structuur als TPCtoss onder Jules/Apps)
APP_DIR=/mnt/p/Jules/Apps/NAIC
DATA_DIR=/mnt/p/Jules/Apps/NAIC/data
LOG_DIR=/mnt/p/Jules/Apps/NAIC/logs

# Database
DB_FILE=/mnt/p/Jules/Apps/NAIC/data/naic_eu.db

# Repository
REPO_URL=https://github.com/Jules5235/sms.git
BRANCH=cursor/eu-naic-database-poc-d9c0

# Systemd
SYSTEMD_SERVICE=naic-etl
INSTALL_SYSTEMD=yes

# ETL-schema (zaterdag 07:00)
ETL_TIMER=Sat *-*-* 07:00:00
