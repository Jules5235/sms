# Productie — NUC6i5 (database + ETL, 24/7)
NUC_HOST=192.168.178.79
NUC_USER=jules
NUC_NAME=NUC6i5

# Runtime + database op lokale schijf van de NUC (niet op P:)
APP_DIR=/home/jules/naic
DATA_DIR=/home/jules/naic/data
LOG_DIR=/home/jules/naic/logs
DB_FILE=/home/jules/naic/data/naic_eu.db

SYSTEMD_SERVICE=naic-etl
API_SERVICE=naic-api
API_PORT=8080
INSTALL_SYSTEMD=yes
ETL_TIMER="Sat *-*-* 07:00:00"

